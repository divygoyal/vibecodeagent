# =============================================================================
#                    VIBECODEAGENT ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values
# cp env.template .env
# =============================================================================

# -----------------------------------------------------------------------------
# DOMAIN CONFIGURATION
# -----------------------------------------------------------------------------
DOMAIN=agent.divygoyal.in
PROTOCOL=https

# -----------------------------------------------------------------------------
# GITHUB OAUTH (Create at: https://github.com/settings/developers)
# -----------------------------------------------------------------------------
# Application name: ClawBot
# Homepage URL: https://agent.divygoyal.in
# Callback URL: https://agent.divygoyal.in/api/auth/callback/github
GITHUB_ID=your_github_client_id_here
GITHUB_SECRET=your_github_client_secret_here

# -----------------------------------------------------------------------------
# GITHUB APP (Phase 2 — Create at: https://github.com/settings/apps)
# Selective per-repo access via installation tokens. App ID + Client ID are
# public; Client Secret + Private Key are confidential.
# Slug = kebab-case App name (find on App settings page → "Public link").
# -----------------------------------------------------------------------------
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_CLIENT_ID=your_github_app_client_id
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
GITHUB_APP_SLUG=trafficclaw-diagnostic
# Paste the full .pem (with BEGIN/END lines, newlines escaped as \n in single-line .env):
GITHUB_APP_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (Create at: https://console.cloud.google.com/apis/credentials)
# -----------------------------------------------------------------------------
# Authorized redirect URI: https://agent.divygoyal.in/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# -----------------------------------------------------------------------------
# NEXTAUTH (Generate with: openssl rand -base64 32)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=https://agent.divygoyal.in

# -----------------------------------------------------------------------------
# ADMIN API CONFIGURATION
# -----------------------------------------------------------------------------
ADMIN_API_KEY=generate_a_secure_key_here
ADMIN_API_URL=http://admin-api:8000
# DATABASE_URL=sqlite+aiosqlite:///./data/admin.db # Uncomment to override default

# Fernet key for OAuth token encryption at rest. Optional —
# admin auto-derives one from ADMIN_API_KEY if this is unset.
# Override only if you want to rotate independently of ADMIN_API_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OAUTH_TOKEN_ENC_KEY=generate_a_fernet_key_here

# -----------------------------------------------------------------------------
# GOOGLE VERTEX AI / GEN AI
# -----------------------------------------------------------------------------
# Express Mode key (starts with AQ...) or full Vertex service-account setup.
GOOGLE_VERTEX_API_KEY=your_vertex_express_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_GENAI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_FALLBACK_MODEL=gemini-3-flash-preview
GOOGLE_CLOUD_LOCATION=global
# Optional full Vertex mode:
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Legacy fallback only. Prefer GOOGLE_VERTEX_API_KEY.
# GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# DODO PAYMENTS
# -----------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_payments_webhook_signing_key_here

# Bearer token used by scheduled jobs.
CRON_SECRET=generate_a_random_secret_here

# -----------------------------------------------------------------------------
# TELEGRAM ADMIN NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
# Create a bot with @BotFather and get the token
# Get your chat ID from @userinfobot
ADMIN_TELEGRAM_BOT_TOKEN=your_admin_bot_token_here
ADMIN_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# RESOURCE LIMITS (Adjust based on VPS specs)
# -----------------------------------------------------------------------------
MAX_USERS=50
DEFAULT_RAM_LIMIT=256m
DEFAULT_CPU_LIMIT=0.25
DATA_DIR=/home/ubuntu/clawbot-data

# -----------------------------------------------------------------------------
# OPENCLAW IMAGE (Custom image with GitHub CLI pre-installed)
# -----------------------------------------------------------------------------
OPENCLAW_IMAGE=clawbot:latest

# -----------------------------------------------------------------------------
# SSL CONFIGURATION (Let's Encrypt)
# -----------------------------------------------------------------------------
SSL_EMAIL=your_email@example.com
