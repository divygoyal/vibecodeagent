FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Install system dependencies including Node.js (for GA4/GSC plugins) and git
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg git && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get purge -y gnupg && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Nanobot (pinned commit) with the Telegram channel extra + Google Gen AI SDK for Vertex Express mode.
# - [telegram] pulls python-telegram-bot; without it the bot silently runs websocket-only.
# - Pinned to a known-good commit so an upstream "latest" change can't silently break the
#   provider call signature (e.g. the on_stream_recover kwarg regression).
RUN pip install --no-cache-dir "nanobot-ai[telegram] @ git+https://github.com/HKUDS/nanobot.git@6e462e62a65d03470226afe03b6521ecdf8ef8f5" google-genai

# Pre-install plugin dependencies (eliminates Node.js cold-start on first analytics query)
COPY plugins/google-analytics /app/plugins/google-analytics
COPY plugins/google-search-console /app/plugins/google-search-console
RUN cd /app/plugins/google-analytics && npm install --production 2>/dev/null || true
RUN cd /app/plugins/google-search-console && npm install --production 2>/dev/null || true

# Wrapper commands so the bot can invoke skills by name — e.g.
# `google-analytics list-properties` — which is nanobot's natural skill
# convention (via exec / run_cli_app), not just the full
# `node /data/.nanobot/workspace/skills/.../index.js` path. Without these the
# bare-name calls fail with "command not found", which the LLM misreads as an
# auth error and reports as invalid_request / "connections need re-auth".
RUN printf '#!/bin/sh\nexec node /data/.nanobot/workspace/skills/google-analytics/index.js "$@"\n' > /usr/local/bin/google-analytics && \
    printf '#!/bin/sh\nexec node /data/.nanobot/workspace/skills/google-search-console/index.js "$@"\n' > /usr/local/bin/google-search-console && \
    chmod +x /usr/local/bin/google-analytics /usr/local/bin/google-search-console

# Change HOME to /data so nanobot reads config from /data/.nanobot/config.json
ENV HOME=/data

# Pre-create workspace structure
RUN mkdir -p /data/.nanobot/workspace/skills /data/.nanobot/workspace/memory

# Copy Vertex Express provider patch and entrypoint
COPY scripts/nanobot_sitecustomize.py /app/nanobot_sitecustomize.py
COPY scripts/nanobot_entrypoint.sh /app/nanobot_entrypoint.sh
RUN chmod +x /app/nanobot_entrypoint.sh

# Nanobot gateway listens on 18790 by default
EXPOSE 18790

ENTRYPOINT ["/app/nanobot_entrypoint.sh"]
CMD []
