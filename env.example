# ============================================
# ClawBot Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ============= GitHub OAuth =================
# Create at: https://github.com/settings/applications/new
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret

# ============= GitHub App (Phase 2 — selective per-repo access) =============
# Create at: https://github.com/settings/apps → New GitHub App
# App ID + Client ID are public; Client Secret + Private Key MUST stay secret.
# GITHUB_APP_SLUG = the kebab-case App name in the install URL
#   (find it on the App's settings page → "Public link").
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_CLIENT_ID=your_github_app_client_id
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
GITHUB_APP_SLUG=trafficclaw-diagnostic
# Multi-line private key — paste the full .pem inside quotes:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=

# ============= NextAuth.js ==================
# Random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=https://your-domain.com

# ============= Admin API ====================
# Random key: openssl rand -hex 32
ADMIN_API_KEY=your_admin_api_key_here
ADMIN_API_URL=http://admin-api:8000

# ============= Cron Secret ===================
# Bearer token used by the leaderboard-cron service to call the daily refresh.
# Generate: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Fernet key for OAuth token encryption at rest. Optional —
# if unset, admin auto-derives one from ADMIN_API_KEY. Override only if you
# want to rotate independently of ADMIN_API_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OAUTH_TOKEN_ENC_KEY=your_fernet_key_here

# ============= Gemini API ===================
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============= OpenClaw Image ===============
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# ============= Alert Notifications ==========
# Your Telegram bot for receiving admin alerts
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id

# ============= Watchdog Settings ============
HEALTH_CHECK_INTERVAL=60
MAX_RESTART_ATTEMPTS=3

# ============= Database =====================
# SQLite (default) - no change needed
# DATABASE_URL=sqlite+aiosqlite:///./data/admin.db

# For production with PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/clawbot
